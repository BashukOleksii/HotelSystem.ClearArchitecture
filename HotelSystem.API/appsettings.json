{
  "ConnectionStrings": {
    "HotelDatabase": ""
  },
  "Jwt": {
    "Issuer": "HotelSystem",
    "Audience": "HotelSystem.Api",
    "AccessTokenMinutes": 15
  },
  "PasswordHashing": { "WorkFactor": 12 },
  "BootstrapAdmin": { "Enabled": false },
  "PhotoStorage": {
    "EnableCleanupWorker": true,
    "PollSeconds": 15,
    "BatchSize": 20,
    "LeaseSeconds": 120
  },
  "PhotoUrls": {
    "PublicBaseUrl": "",
    "RoutePrefix": "/api/media"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200", "http://127.0.0.1:4200" ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
