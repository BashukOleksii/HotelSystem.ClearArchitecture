    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Content Update="appsettings.Local.json;appsettings.Local.example.json"
             CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
